[Unit]
Description=Vibeshine virtual-display control connection
Requires=vibeshine-vkms.service
After=vibeshine-vkms.service
# Let an admitted connector request finish before the machine host completes
# its shutdown fence; the bounded request cgroup still ends before the
# client's longer protocol deadline.
Before=vibeshine.service

[Service]
Type=exec
User=root
ExecStart=@VIBESHINE_PRIVILEGED_LIBEXEC_INSTALL_DIR@/vibeshine-vkms-peercred @VIBESHINE_PRIVILEGED_LIBEXEC_INSTALL_DIR@/vibeshine-vkms control
StandardInput=socket
StandardOutput=socket
StandardError=journal
UMask=0077
RuntimeMaxSec=5s
TimeoutStopSec=1s
KillMode=control-group
SendSIGKILL=yes
MemoryMax=32M
TasksMax=16
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=-/sys/kernel/config/vibeshine-drm -/sys/kernel/config/vkms /run/vibeshine/vkms-leases
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX
