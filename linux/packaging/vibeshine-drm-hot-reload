#!/usr/bin/env bash
# Reload the Vibeshine DRM module while preserving the surrounding user
# session. This runs as a detached system service because restarting KWin
# disconnects every Wayland client, including the terminal which launched it.

set -Eeuo pipefail
IFS=$'\n\t'

readonly program_name="vibeshine-drm-hot-reload"
readonly module_name="vibeshine_drm"
readonly pool_service="vibeshine-vkms.service"
readonly compositor_service="plasma-kwin_wayland.service"
readonly sunshine_service="vibeshine.service"

target_uid="${1:-}"
target_user="${2:-}"
recovery_needed=0

log() {
  printf '%s: %s\n' "$program_name" "$*"
}

error() {
  printf '%s: error: %s\n' "$program_name" "$*" >&2
}

die() {
  error "$*"
  exit 1
}

user_systemctl() {
  systemctl --machine="${target_user}@.host" --user "$@"
}

wait_for_user_service() {
  local service=$1
  local attempts=${2:-30}
  local index

  for ((index = 0; index < attempts; ++index)); do
    if user_systemctl is-active --quiet "$service"; then
      return 0
    fi
    sleep 1
  done
  return 1
}

recover_services() {
  local recovery_rc=0

  ((recovery_needed)) || return 0
  recovery_needed=0
  error "reload did not complete; attempting to restore the desktop and streaming services"

  modprobe "$module_name" create_default_dev=0 || recovery_rc=1
  systemctl start "$pool_service" || recovery_rc=1
  user_systemctl start "$compositor_service" || recovery_rc=1
  wait_for_user_service "$compositor_service" 30 || recovery_rc=1
  user_systemctl restart "$sunshine_service" || recovery_rc=1

  if ((recovery_rc)); then
    error "automatic recovery was incomplete; inspect this unit with journalctl"
  else
    log "desktop and streaming services were restored after the failed reload"
  fi
}

on_exit() {
  local rc=$?

  if ((rc != 0)); then
    recover_services || true
  fi
  exit "$rc"
}

trap on_exit EXIT

((EUID == 0)) || die "this helper must run as root"
[[ "$target_uid" =~ ^[0-9]+$ ]] || die "invalid target UID"
[[ "$target_user" =~ ^[a-z_][a-z0-9_-]*$ ]] || die "invalid target user"
[[ "$(id -u "$target_user")" == "$target_uid" ]] || die "target user and UID do not match"
[[ -S "/run/user/${target_uid}/bus" ]] || die "target user's systemd bus is unavailable"

for command_name in cat date flock getcap grep id install journalctl modinfo modprobe readlink sleep systemctl; do
  command -v "$command_name" >/dev/null 2>&1 || die "required command not found: $command_name"
done

install -d -m 0755 /run/vibeshine
exec 9>/run/vibeshine/drm-hot-reload.lock
flock -n 9 || die "another Vibeshine DRM hot reload is already running"

installed_version="$(modinfo -F version "$module_name" 2>/dev/null || true)"
installed_srcversion="$(modinfo -F srcversion "$module_name" 2>/dev/null || true)"
[[ -n "$installed_version" && -n "$installed_srcversion" ]] || die "installed module metadata is unavailable"

loaded_version="$(cat "/sys/module/${module_name}/version" 2>/dev/null || true)"
loaded_srcversion="$(cat "/sys/module/${module_name}/srcversion" 2>/dev/null || true)"
log "module versions before reload: installed=${installed_version} loaded=${loaded_version:-not-loaded}"

# Give the launching terminal enough time to print the handoff message before
# its Wayland connection disappears.
sleep 3

recovery_needed=1
log "stopping Sunshine; active streams and launched games will disconnect"
user_systemctl stop "$sunshine_service"

if [[ "$loaded_version" == "$installed_version" &&
      "$loaded_srcversion" == "$installed_srcversion" ]]; then
  log "the loaded DRM module already matches the installed module; skipping compositor restart"
else
  recovery_needed=1

  log "stopping KWin so it releases the virtual DRM card"
  user_systemctl stop "$compositor_service"

  log "removing the virtual-display pool"
  systemctl stop "$pool_service"

  log "unloading ${module_name}"
  modprobe -r "$module_name"
  [[ ! -d "/sys/module/${module_name}" ]] || die "the old module remains loaded"

  log "loading the newly installed ${module_name}"
  modprobe "$module_name" create_default_dev=0

  loaded_version="$(cat "/sys/module/${module_name}/version" 2>/dev/null || true)"
  loaded_srcversion="$(cat "/sys/module/${module_name}/srcversion" 2>/dev/null || true)"
  [[ "$loaded_version" == "$installed_version" ]] || \
    die "loaded module version ${loaded_version:-missing} does not match installed version ${installed_version}"
  [[ "$loaded_srcversion" == "$installed_srcversion" ]] || \
    die "loaded module source identity does not match the installed module"

  log "recreating the virtual-display pool"
  systemctl start "$pool_service"

  log "starting KWin with the reloaded DRM device"
  user_systemctl start "$compositor_service"
  wait_for_user_service "$compositor_service" 30 || die "KWin did not become active"
fi

sunshine_start_epoch="$(date +%s)"
log "starting Sunshine"
user_systemctl start "$sunshine_service"
wait_for_user_service "$sunshine_service" 30 || die "Sunshine did not become active"

sunshine_binary="$(readlink -f /home/"$target_user"/.local/bin/sunshine)"
sunshine_caps="$(getcap "$sunshine_binary" 2>/dev/null || true)"
[[ "$sunshine_caps" == *cap_sys_admin* && "$sunshine_caps" == *cap_sys_nice* ]] || \
  die "Sunshine capabilities are missing after restart"

encoder_deadline=$((SECONDS + 45))
while ((SECONDS < encoder_deadline)); do
  sunshine_log="$(journalctl --since "@${sunshine_start_epoch}" \
    _UID="$target_uid" _SYSTEMD_USER_UNIT="$sunshine_service" --no-pager 2>/dev/null || true)"
  if grep -Fq "Found H.264 encoder: h264_nvenc [nvenc]" <<<"$sunshine_log" &&
     grep -Fq "Found HEVC encoder: hevc_nvenc [nvenc]" <<<"$sunshine_log" &&
     grep -Fq "Found AV1 encoder: av1_nvenc [nvenc]" <<<"$sunshine_log"; then
    recovery_needed=0
    log "hot reload complete: module=${loaded_version}, KWin active, Sunshine NVENC probes passed"
    exit 0
  fi
  sleep 1
done

die "Sunshine restarted, but its NVENC readiness checks did not complete"
