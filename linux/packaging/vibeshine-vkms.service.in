[Unit]
Description=Vibeshine virtual display pool
Documentation=https://docs.kernel.org/gpu/vkms.html
Requires=vibeshine-drm-setup.service
Wants=vibeshine-vkms-control.socket
After=systemd-modules-load.service vibeshine-drm-setup.service
Before=display-manager.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=@VIBESHINE_PRIVILEGED_LIBEXEC_INSTALL_DIR@/vibeshine-vkms start
ExecStop=@VIBESHINE_PRIVILEGED_LIBEXEC_INSTALL_DIR@/vibeshine-vkms stop
TimeoutStartSec=30s
TimeoutStopSec=30s
UMask=0022

[Install]
WantedBy=multi-user.target
