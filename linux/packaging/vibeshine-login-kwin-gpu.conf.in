# Plasma Login starts KWin directly. Scope the same root-owned GPU bridge to
# the compositor; it removes itself from the environment before child launch.
[Service]
UnsetEnvironment=LD_AUDIT LD_DEBUG LD_DEBUG_OUTPUT LD_LIBRARY_PATH LD_ORIGIN_PATH LD_PROFILE LD_SHOW_AUXV
Environment=LD_PRELOAD=@VIBESHINE_KWIN_GPU_LIBRARY_PATH@
Environment=VIBESHINE_KWIN_GPU_PRELOAD_ACTIVE=1
