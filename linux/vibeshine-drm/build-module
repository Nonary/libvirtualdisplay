#!/usr/bin/env bash
# Build the module against one kernel, matching the compiler family recorded in
# that kernel's configuration. DKMS and the direct installer share this path.

set -uo pipefail

PROGRAM_NAME="vibeshine-drm-build"
MODULES_ROOT=""
MINIMUM_KERNEL_MAJOR=6
MINIMUM_KERNEL_MINOR=16

log() {
  printf '%s: %s\n' "$PROGRAM_NAME" "$*" >&2
}

error() {
  printf '%s: error: %s\n' "$PROGRAM_NAME" "$*" >&2
}

configure_build_paths() {
  MODULES_ROOT=$1
}

validate_kernel_release() {
  local kernel_release=$1

  case "$kernel_release" in
    "" | *[!A-Za-z0-9._+-]*)
      error "unsafe kernel release string: '${kernel_release}'"
      return 1
      ;;
  esac
}

kernel_version_is_supported() {
  local kernel_release=$1 kernel_major kernel_minor

  if [[ ! "$kernel_release" =~ ^([0-9]+)\.([0-9]+)(\.[0-9]+)?([-+].*)?$ ]]; then
    return 2
  fi
  kernel_major=$((10#${BASH_REMATCH[1]}))
  kernel_minor=$((10#${BASH_REMATCH[2]}))
  ((kernel_major > MINIMUM_KERNEL_MAJOR ||
    (kernel_major == MINIMUM_KERNEL_MAJOR && kernel_minor >= MINIMUM_KERNEL_MINOR)))
}

require_supported_kernel() {
  local kernel_release=$1 result

  if kernel_version_is_supported "$kernel_release"; then
    return 0
  else
    result=$?
  fi
  if ((result == 2)); then
    error "could not determine the Linux version from kernel release '${kernel_release}'"
  else
    error "managed virtual displays require Linux 6.16 or newer; running kernel is ${kernel_release}"
  fi
  return 1
}

build_module() {
  local kernel_release=$1
  local source_dir=$2
  local build_dir config_file make_arg llvm_mode_set=0
  local -a make_args forwarded_make_args

  shift 2
  forwarded_make_args=("$@")

  validate_kernel_release "$kernel_release" || return 1
  require_supported_kernel "$kernel_release" || return 1
  if [[ ! -d "$source_dir" || -L "$source_dir" || ! -f "$source_dir/Makefile" ]]; then
    error "module source directory is unavailable or unsafe: ${source_dir}"
    return 1
  fi

  build_dir="$MODULES_ROOT/$kernel_release/build"
  config_file="$build_dir/.config"
  if [[ ! -d "$build_dir" || ! -f "$build_dir/Makefile" ]]; then
    error "kernel build files are unavailable at ${build_dir}"
    return 1
  fi
  if ! command -v make >/dev/null 2>&1; then
    error "required command not found: make"
    return 1
  fi

  make_args=(-C "$build_dir" "M=$source_dir")
  for make_arg in "${forwarded_make_args[@]}"; do
    [[ "$make_arg" == LLVM=* ]] && llvm_mode_set=1
  done
  if [[ -f "$config_file" ]] && grep -q '^CONFIG_CC_IS_CLANG=y$' "$config_file"; then
    log "kernel ${kernel_release} was built with Clang; enabling LLVM Kbuild mode"
    ((llvm_mode_set)) || make_args+=(LLVM=1)
  fi
  make_args+=("${forwarded_make_args[@]}")
  make_args+=(modules)
  make "${make_args[@]}"
}

main() {
  local kernel_release=${1:-}
  local source_dir script_dir
  local -a forwarded_make_args

  if [[ -z "$kernel_release" ]]; then
    kernel_release=$(uname -r) || return 1
  else
    shift
  fi
  script_dir=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P) || return 1
  source_dir=$script_dir
  if [[ $# -gt 0 && "$1" != *=* && "$1" != -* ]]; then
    source_dir=$1
    shift
  fi
  forwarded_make_args=("$@")

  configure_build_paths /lib/modules
  build_module "$kernel_release" "$source_dir" "${forwarded_make_args[@]}"
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  main "$@"
fi
